{
  "name": "agoralume-frontend",
  "version": "0.1.0",
  "description": "Web frontend for AgoraLume, an open-source platform for user and multi-AI group chats with modular personas.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "keywords": [],
  "author": "",
  "scripts": {
    "dev": "vite",
    "dev:api": "cross-env VITE_API_BASE_URL=http://127.0.0.1:8080 vite",
    "dev:proxy": "cross-env VITE_SAME_ORIGIN=1 vite --host",
    "backend": "cargo run --manifest-path ../backend/Cargo.toml",
    "dev:full": "concurrently -k -n backend,web -c blue,green \"pnpm backend\" \"pnpm dev:api\"",
    "dev:single": "concurrently -k -n backend,web -c blue,green \"pnpm backend\" \"pnpm dev:proxy\"",
    "build": "tsc --noEmit && vite build",
    "build:bundle": "tsc --noEmit && cross-env VITE_SAME_ORIGIN=1 vite build",
    "preview": "vite preview",
    "preview:proxy": "vite preview --host",
    "start:single": "concurrently -k -n backend,web -c blue,green \"pnpm backend\" \"pnpm build:bundle && pnpm preview:proxy\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "openapi": "cargo run --quiet --manifest-path ../backend/Cargo.toml -- --dump-openapi ../openapi.yml",
    "gen:types": "openapi-typescript ../openapi.yml -o src/lib/api/schema.d.ts",
    "gen:api": "pnpm openapi && pnpm gen:types"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@mantine/core": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@tabler/icons-react": "^3.45.0",
    "@tanstack/react-query": "^5.101.4",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "openapi-typescript": "^6.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
