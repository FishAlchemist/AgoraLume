# Initial backend the frontend points at, e.g. http://localhost:8080.
# Leave unset to start against the built-in in-memory mock (fully offline).
# This is only the DEFAULT — the backend can be changed at runtime under
# Settings › Backend connection, and that choice is persisted.
VITE_API_BASE_URL=

# Set to 1 to start on the mock even when VITE_API_BASE_URL is defined
# (handy while iterating on the UI). Runtime switching still applies.
VITE_USE_MOCK=
