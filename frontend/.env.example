# Initial backend the frontend points at, e.g. http://localhost:8080.
# Leave unset to start against the built-in in-memory mock (fully offline).
# This is only the DEFAULT — the backend can be changed at runtime under
# Settings › Backend connection, and that choice is persisted.
VITE_API_BASE_URL=

# Set to 1 to start on the mock even when VITE_API_BASE_URL is defined
# (handy while iterating on the UI). Runtime switching still applies.
VITE_USE_MOCK=

# --- Single-port dev proxy (pnpm dev:single / dev:proxy) -------------------
# These only affect the Vite dev server, which proxies the backend's API/SSE
# routes so the whole app runs on one port with hot reload.

# Backend the dev server proxies to (default http://127.0.0.1:8080). Change it
# if the backend runs elsewhere — keep it in sync with the backend's
# AGORALUME_BIND.
VITE_PROXY_TARGET=

# Port the Vite dev server listens on — the single exposed port in dev. Unset
# uses Vite's default (5173); an explicit value is honoured strictly (a clash
# fails instead of silently moving).
VITE_DEV_PORT=

# Extra hostnames the dev server may be reached on, beyond localhost — needed to
# expose it through a tunnel (e.g. Cloudflare's *.trycloudflare.com). Comma-
# separated; a leading dot matches subdomains. Unset uses Vite's default list.
# Put your own tunnel host in the gitignored frontend/.env, e.g.:
#   VITE_ALLOWED_HOSTS=.trycloudflare.com
VITE_ALLOWED_HOSTS=
