# Point the frontend at an AgoraLume backend, e.g. http://localhost:8080
# Leave unset to run entirely against the built-in in-memory mock
# (fully offline, no backend required).
VITE_API_BASE_URL=

# Set to 1 to force the mock even when VITE_API_BASE_URL is defined
# (handy while iterating on the UI).
VITE_USE_MOCK=
