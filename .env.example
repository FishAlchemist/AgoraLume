# AgoraLume backend configuration.
#
# Copy this file to `.env` (next to the executable) and edit it. Every line is
# optional — the defaults run a self-contained demo with simulated replies.
# Anything you set in your real shell environment overrides the file.

# --- LLM (real model replies) ---------------------------------------------
# Off by default (simulated replies). Set to 1 to drive agents with a real
# OpenAI-compatible model, then fill in the endpoint below.
#AGORALUME_LLM=1

# OpenAI-compatible API root. Examples:
#   https://api.openai.com/v1     (OpenAI)
#   https://openrouter.ai/api/v1  (OpenRouter)
#   http://localhost:11434/v1     (Ollama, local, no key)
#   https://generativelanguage.googleapis.com/v1beta/openai/  (Gemini — see note)
# Note: the Gemini OpenAI-compat URL above is auto-detected and routed to rig's
# native Gemini provider (logged at startup), so Gemini's thought signatures
# round-trip correctly. Every other URL is treated as a plain OpenAI endpoint.
#AGORALUME_LLM_BASE_URL=http://localhost:11434/v1

# Model to request. Nothing is hard-coded — you choose it.
#AGORALUME_LLM_MODEL=llama3.1

# API key. Leave unset for local endpoints that need no auth.
#AGORALUME_LLM_API_KEY=sk-...

# Max tokens per reply (default 512).
#AGORALUME_LLM_MAX_TOKENS=512

# Server-wide cap on LLM requests per rolling minute, so a free-tier quota isn't
# blown (default 15, matching Gemini's free flash-lite tier). Agents that would
# exceed it simply wait their turn. Set 0 to disable, or higher on a paid tier.
#AGORALUME_LLM_MAX_RPM=15

# Automatic retries on a transient failure (429 / 5xx / transport) before the
# error surfaces to the chat (default 2). Set 0 to disable auto-retry.
#AGORALUME_LLM_MAX_RETRIES=2

# Base backoff before the first retry, in ms; each further retry doubles it
# (default 1000). A server-supplied hint (e.g. a 429's retryDelay) wins over it.
#AGORALUME_LLM_RETRY_BASE_MS=1000

# --- Context compression --------------------------------------------------
# Older conversation is folded into a running per-group summary so the prompt
# every agent reads stays bounded (without a long-term memory system). Only runs
# with a real model — the mock has nothing to summarize with.
#
# High-water mark: once a group's un-summarized tail passes this many lines, the
# oldest are folded into the summary (default 50). Set 0 to disable compression.
#AGORALUME_COMPRESS_AFTER=50
# How many most-recent lines stay verbatim when compressing — the "don't forget
# what just happened" window (default 20; keep it below COMPRESS_AFTER).
#AGORALUME_COMPRESS_KEEP=20
# Output-token ceiling for one summarization call (default 1024). Separate from
# LLM_MAX_TOKENS because a running summary is a cumulative digest, not one reply.
#AGORALUME_COMPRESS_MAX_TOKENS=1024

# --- Cost estimate (debug panel) ------------------------------------------
# Optional token pricing, per 1,000,000 tokens, to show an estimated cost in
# the debug panel (always "for reference only"). Set input + output; the cached
# rate defaults to the input rate when omitted, so a discounted cache rate is
# what reveals the savings. Leave all unset to show token counts only.
#AGORALUME_LLM_PRICE_INPUT=0.15
#AGORALUME_LLM_PRICE_OUTPUT=0.60
#AGORALUME_LLM_PRICE_CACHED_INPUT=0.0375
#AGORALUME_LLM_PRICE_CURRENCY=USD

# --- Persistence ----------------------------------------------------------
# Save the workspace (personas/organizations/groups/settings) and chat logs to
# the data dir so they survive a restart. Defaults to on whenever AGORALUME_LLM
# is on (a real run is worth keeping; a mock demo is throwaway). Set explicitly
# to force either way.
#AGORALUME_PERSIST=1
# Where persisted state lives (default ./data): workspace.json + messages/<id>.json.
#AGORALUME_DATA_DIR=./data

# --- Server ---------------------------------------------------------------
# Address to bind (default 127.0.0.1:8080). Use 0.0.0.0:<port> to expose on the
# LAN; the bundled exe serves the API and the site together on this one port.
#AGORALUME_BIND=127.0.0.1:8080

# Open a browser on startup when serving the bundled site (default on).
# Set to 0 to skip.
#AGORALUME_OPEN=0

# Log verbosity (e.g. info, debug, agoralume_backend=debug).
#RUST_LOG=info
